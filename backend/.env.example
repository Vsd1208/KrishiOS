APP_NAME=KrishiOS
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true

API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=krishios
POSTGRES_USER=krishios
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Sprint 2 — Knowledge Infrastructure
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=krishios_documents

RETRIEVAL_INDEX_PREFIX=krishios-index
RETRIEVAL_LIVE_ALIAS=krishios-live
RETRIEVAL_DELTA_ALIAS=krishios-delta
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CACHE_TTL_SECONDS=300

RANKING_WEIGHT_SEMANTIC=0.45
RANKING_WEIGHT_AUTHORITY=0.15
RANKING_WEIGHT_FRESHNESS=0.15
RANKING_WEIGHT_CROP=0.08
RANKING_WEIGHT_STATE=0.05
RANKING_WEIGHT_DISTRICT=0.05
RANKING_WEIGHT_SEASON=0.04
RANKING_WEIGHT_LANGUAGE=0.03

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=v1

DOCUMENT_STORAGE_PATH=/data/documents
MAX_UPLOAD_SIZE_MB=50

LOG_LEVEL=INFO
LOG_JSON=false

