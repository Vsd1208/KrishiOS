APP_NAME=KrishiOS
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true

API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=krishios
POSTGRES_USER=krishios
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Sprint 2 — Knowledge Infrastructure
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=krishios_documents

RETRIEVAL_INDEX_PREFIX=krishios-index
RETRIEVAL_LIVE_ALIAS=krishios-live
RETRIEVAL_DELTA_ALIAS=krishios-delta
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CACHE_TTL_SECONDS=300

RANKING_WEIGHT_SEMANTIC=0.45
RANKING_WEIGHT_AUTHORITY=0.15
RANKING_WEIGHT_FRESHNESS=0.15
RANKING_WEIGHT_CROP=0.08
RANKING_WEIGHT_STATE=0.05
RANKING_WEIGHT_DISTRICT=0.05
RANKING_WEIGHT_SEASON=0.04
RANKING_WEIGHT_LANGUAGE=0.03

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=v1

DOCUMENT_STORAGE_PATH=/data/documents
MAX_UPLOAD_SIZE_MB=50

LOG_LEVEL=INFO
LOG_JSON=false

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Sprint 11 — Provider selection (unknown names are startup errors; see GET /api/v1/providers)
VISION_PROVIDER=mock-v1
STT_PROVIDER=mock-stt-v1
TTS_PROVIDER=mock-tts-v1
TRANSLATION_PROVIDER=mock-translation
NLU_PROVIDER=rule-based-nlu
ALLOW_MOCK_PROVIDERS=true
# Third-party processing of farmer data (Gemini, Bhashini, ...) is opt-in (DPDP).
ALLOW_OFF_DEVICE_PROVIDERS=false
NOTIFICATION_CHANNELS=["in_app"]
SUPPORTED_LANGUAGES=["en","hi","te"]
# REFERENCE_DATA_DIR / ML_ARTIFACTS_DIR are set by docker-compose; locally they default to ../ml

# Sprint 11 / Phase 2 measured recommendations (ml/reports/02_multilingual_core.md §4).
# Need: `uv sync --extra local-ml` (or Docker build arg INSTALL_LOCAL_ML=true), HF_TOKEN with
# access to the gated AI4Bharat models, and the model downloads (ml/scripts/download_models.sh).
# HF_TOKEN=
# TRANSLATION_PROVIDER=indictrans2        # test pass rate te 0.550 / hi 0.644 (run 2c5c6baf993a)
# STT_PROVIDER=indicconformer-600m-rnnt   # FLEURS CER te 0.073 / hi 0.063 (run 65d3ea90da08)
# TTS_PROVIDER=mms-tts                    # CC BY-NC: academic demo only
# ML_DEVICE=auto
