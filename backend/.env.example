APP_NAME=KrishiOS
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true

API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=krishios
POSTGRES_USER=krishios
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

LOG_LEVEL=INFO
LOG_JSON=false
